{
  "name": "viago-flyer-generator-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Development-only regression protection for the static VIAGO Flyer Generator",
  "scripts": {
    "validate": "python3 tools/validate_baseline.py",
    "test:validator": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:function": "playwright test tests/function",
    "test:browser": "playwright test tests/browser --grep-invert @visual",
    "test:visual": "playwright test tests/browser/visual.spec.js tests/browser/rotation-visual.spec.js --grep @visual",
    "test:visual:update": "playwright test tests/browser/visual.spec.js tests/browser/rotation-visual.spec.js --grep @visual --update-snapshots",
    "test:studio": "playwright test tests/studio",
    "test:hosted": "playwright test tests/hosted",
    "app": "node tools/template-studio-server.mjs --app",
    "studio": "node tools/template-studio-server.mjs",
    "build:studio:hosted": "node tools/build-hosted-studio.mjs",
    "deploy:studio:hosted": "npm run build:studio:hosted && npx wrangler deploy",
    "test:all": "npm run validate && npm run test:validator && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
